# Supabase (Project Settings → API). Без этих значений сайт работает на демо-данных.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email админа: только он видит /admin и может добавлять тайтлы и серии
ADMIN_EMAIL=

# Публичный адрес сайта
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Загрузка видео прямо с сайта в Bunny Stream (Bunny → Stream → твоя библиотека → API)
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
